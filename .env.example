# Public Supabase client configuration.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: enables the team-import API. This value is bundled into the client, so it's technically not fully secret
# Don't really care though, if someone really wants the api key they can just ask :)
EXPO_PUBLIC_IMPORT_API_KEY=your-import-api-key
