{
  "name": "ultimatestats",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "APP_VARIANT=development expo start",
    "dev": "APP_VARIANT=development npx expo start",
    "android": "APP_VARIANT=development expo run:android",
    "ios": "APP_VARIANT=development expo run:ios",
    "prebuild:android": "APP_VARIANT=development expo prebuild --clean --platform android",
    "prebuild:ios": "APP_VARIANT=development expo prebuild --clean --platform ios",
    "lint": "oxlint --config oxlint.config.mts .",
    "typecheck": "tsc --noEmit",
    "check": "npm run format:check && npm run lint && npm run typecheck",
    "check:all": "npm run check && npm test",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "format:changed": "git diff --name-only -z --diff-filter=d HEAD | xargs -0 -r oxfmt --no-error-on-unmatched-pattern",
    "test": "jest && npm run test:oxlint",
    "test:routes": "jest test/routes",
    "test:oxlint": "node --test scripts/oxlint-plugin/__tests__/*.test.ts",
    "maestro": "MAESTRO_CLI_NO_ANALYTICS=1 maestro test --exclude-tags extended .maestro/tests/",
    "maestro:scrimmage": "MAESTRO_CLI_NO_ANALYTICS=1 maestro test --include-tags scrimmage .maestro/tests/",
    "maestro:smoke": "MAESTRO_CLI_NO_ANALYTICS=1 maestro test --include-tags smoke .maestro/tests/",
    "maestro:ci": "MAESTRO_CLI_NO_ANALYTICS=1 maestro test --exclude-tags extended --format junit --output .maestro/test-output/report.xml .maestro/tests/",
    "maestro:all": "MAESTRO_CLI_NO_ANALYTICS=1 maestro test .maestro/tests/"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@sentry/react-native": "^8.21.0",
    "@supabase/supabase-js": "^2.95.3",
    "@tanstack/react-query": "^5.95.2",
    "expo": "~57.0.8",
    "expo-build-properties": "~57.0.7",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.3",
    "expo-dev-client": "~57.0.9",
    "expo-file-system": "~57.0.0",
    "expo-font": "~57.0.0",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-keep-awake": "~57.0.0",
    "expo-linking": "~57.0.4",
    "expo-print": "~57.0.1",
    "expo-router": "~57.0.8",
    "expo-screen-orientation": "~57.0.1",
    "expo-sharing": "~57.0.7",
    "expo-speech-recognition": "^56.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "expo-updates": "~57.0.10",
    "expo-web-browser": "~57.0.2",
    "immer": "^11.1.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.0",
    "reanimated-color-picker": "^4.1.1",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.75.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/node": "^25.5.2",
    "@types/react": "~19.2.10",
    "eslint-plugin-expo": "^1.1.0",
    "eslint-plugin-testing-library": "^7.16.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.1",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.75.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "private": true
}
