{
  "name": "ultimatestats",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "dev": "APP_VARIANT=development npx expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "APP_VARIANT=development expo run:android",
    "ios": "APP_VARIANT=development expo run:ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck",
    "check:all": "npm run format && npm run check && npm test",
    "format": "prettier --write .",
    "format:changed": "git diff --name-only --diff-filter=d HEAD | xargs -r prettier --write --ignore-unknown",
    "test": "jest",
    "maestro": "MAESTRO_CLI_NO_ANALYTICS=1 maestro test .maestro/tests/",
    "maestro:smoke": "MAESTRO_CLI_NO_ANALYTICS=1 maestro test .maestro/tests/advanced-tracker-smoke.yml",
    "maestro:all": "MAESTRO_CLI_NO_ANALYTICS=1 maestro test .maestro/tests/"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-navigation/bottom-tabs": "^7.15.5",
    "@react-navigation/drawer": "^7.9.8",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.14.5",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.6.0",
    "@supabase/supabase-js": "^2.95.3",
    "@tanstack/react-query": "^5.95.2",
    "expo": "~55.0.12",
    "expo-build-properties": "~55.0.12",
    "expo-clipboard": "~55.0.12",
    "expo-constants": "~55.0.7",
    "expo-dev-client": "~55.0.23",
    "expo-file-system": "~55.0.9",
    "expo-font": "~55.0.4",
    "expo-haptics": "~55.0.13",
    "expo-image": "~55.0.8",
    "expo-keep-awake": "~55.0.4",
    "expo-linking": "~55.0.11",
    "expo-print": "~55.0.12",
    "expo-router": "~55.0.11",
    "expo-screen-orientation": "~55.0.12",
    "expo-sharing": "~55.0.17",
    "expo-speech-recognition": "^3.1.3",
    "expo-splash-screen": "~55.0.16",
    "expo-status-bar": "~55.0.5",
    "expo-symbols": "~55.0.7",
    "expo-system-ui": "~55.0.14",
    "expo-updates": "~55.0.19",
    "expo-web-browser": "~55.0.13",
    "immer": "^11.1.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.4",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-svg": "15.15.3",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.7.2",
    "reanimated-color-picker": "^4.1.1",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/node": "^25.5.2",
    "@types/react": "~19.2.10",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~55.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "~29.7.0",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.9",
    "typescript": "^6.0.2"
  },
  "overrides": {
    "hermes-compiler": "250829098.0.4"
  },
  "private": true
}
