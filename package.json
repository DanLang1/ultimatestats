{
  "name": "ultimatestats",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "APP_VARIANT=development expo start",
    "dev": "APP_VARIANT=development npx expo start",
    "android": "APP_VARIANT=development expo run:android",
    "ios": "APP_VARIANT=development expo run:ios",
    "prebuild:android": "APP_VARIANT=development expo prebuild --clean --platform android",
    "prebuild:ios": "APP_VARIANT=development expo prebuild --clean --platform ios",
    "lint": "oxlint --config oxlint.config.mts .",
    "lint:maestro": "maestro-runner lint .maestro/tests/",
    "typecheck": "tsc --noEmit",
    "check": "npm run format:check && npm run lint && npm run lint:maestro && npm run typecheck",
    "check:all": "npm run check && npm test",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "format:changed": "git diff --name-only -z --diff-filter=d HEAD | xargs -0 -r oxfmt --no-error-on-unmatched-pattern",
    "test": "jest && npm run test:oxlint",
    "test:coverage": "jest --coverage",
    "test:routes": "jest test/routes",
    "test:oxlint": "node --test scripts/oxlint-plugin/__tests__/*.test.ts",
    "pre-release": "bash scripts/pre-release.sh",
    "pre-release:fast": "bash scripts/pre-release.sh --skip-maestro",
    "maestro": "maestro-runner --platform ios --condition-timeout 2000 --config .maestro/config.yaml --output .maestro/test-output/reports test --exclude-tags extended .maestro/tests/",
    "maestro:scrimmage": "maestro-runner --platform ios --condition-timeout 2000 --config .maestro/config.yaml --output .maestro/test-output/reports test --include-tags scrimmage .maestro/tests/",
    "maestro:smoke": "maestro-runner --platform ios --condition-timeout 2000 --config .maestro/config.yaml --output .maestro/test-output/reports test --include-tags smoke .maestro/tests/",
    "maestro:advanced": "maestro-runner --platform ios --condition-timeout 2000 --config .maestro/config.yaml --output .maestro/test-output/reports test --include-tags advanced .maestro/tests/",
    "maestro:basic": "maestro-runner --platform ios --condition-timeout 2000 --config .maestro/config.yaml --output .maestro/test-output/reports test --include-tags basic .maestro/tests/",
    "maestro:team": "maestro-runner --platform ios --condition-timeout 2000 --config .maestro/config.yaml --output .maestro/test-output/reports test --include-tags team .maestro/tests/",
    "maestro:ci": "maestro-runner --platform ios --condition-timeout 2000 --config .maestro/config.yaml --output .maestro/test-output/ci --flatten test --exclude-tags extended .maestro/tests/",
    "maestro:all": "maestro-runner --platform ios --condition-timeout 2000 --config .maestro/config.yaml --output .maestro/test-output/reports test .maestro/tests/",
    "maestro:parallel": "bash scripts/maestro-parallel.sh",
    "maestro:classic": "MAESTRO_CLI_NO_ANALYTICS=1 maestro test --exclude-tags extended .maestro/tests/"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-vector-icons/material-design-icons": "^14.0.0",
    "@sentry/react-native": "^8.21.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.105.0",
    "expo": "~57.0.31",
    "expo-build-properties": "~57.0.22",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.22",
    "expo-dev-client": "~57.0.20",
    "expo-file-system": "~57.0.0",
    "expo-font": "~57.0.0",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-keep-awake": "~57.0.0",
    "expo-linking": "~57.0.13",
    "expo-router": "~57.0.29",
    "expo-screen-orientation": "~57.0.3",
    "expo-sharing": "~57.0.24",
    "expo-speech-recognition": "^57.1.1",
    "expo-splash-screen": "~57.0.10",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.26",
    "expo-web-browser": "~57.0.3",
    "immer": "^11.2.9",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "reanimated-color-picker": "^5.1.3",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.90.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "29.5.14",
    "@types/node": "^25.9.9",
    "@types/react": "~19.2.10",
    "eslint-plugin-expo": "^1.2.1",
    "eslint-plugin-testing-library": "^7.16.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "maestro-runner": "^1.1.29",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "expo": {
    "install": {
      "exclude": [
        "@sentry/react-native"
      ]
    }
  },
  "private": true
}
